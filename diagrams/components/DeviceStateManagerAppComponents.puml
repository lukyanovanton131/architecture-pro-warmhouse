@startuml
title Device State Service Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml


Container_Boundary(WarmhouseSystem, "Warmhouse System") {
  Container(DeviceStateManagerApp, "Сервис состояния устройства", "Go", "Обновляет показатели устройств")
  Container(Database, "Database", "PostgreSQL", "Хранение данных с датчиков устройств")
  Container(MessageBus, "Message Bus", "Kafka", "Транспорт данных телеметрии")
}


Container(DeviceStateManagerApp, "Device Control Service", "Java, Spring") {
  Component(DeviceStateManager, "DeviceStateManager", "Обновдение состояния устройства")
  Component(SensorRepository, "SensorRepository", "Доступ к БД")
  Component(MessageBusConsumer, "Message Bus Consumer", "Чтение данных телеметрии")
}

Rel(MessageBusConsumer,DeviceStateManager,"Данные телеметрии")
Rel(DeviceStateManager,SensorRepository,"Данные с устройства")
Rel(SensorRepository,Database,"Чтение и запись данных")
Rel(MessageBusConsumer,MessageBus,"Чтение сообщения сервиса телеметрии")

@enduml