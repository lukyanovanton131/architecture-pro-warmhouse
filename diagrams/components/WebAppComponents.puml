@startuml
title Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(user, "User", "Пользователь системы")
Person(admin, "Admin", "Администратор системы")

Container_Boundary(WarmhouseSystem, "Warmhouse System") {
  Container(WebApp, "Web приложение", ".net", "Обрабатывает взаимодействие с пользователем")
  Container(Database, "Database", "PostgreSQL", "Хранение данных об устройствах и пользователях")
  Container(MessageBus, "Шина сообщений", "Kafka", "Транспорт данных телеметрии и команд управления")
}

Container(WebApp, "Web Application", "Java, Spring") {
  Component(AuthController, "AuthController", "Обработка аутентификации и авторизации")
  Component(AdminController, "AdminController", "Администрирование системы")
  Component(DeviceControlController, "DeviceControlController", "Управление устройствами")
  Component(MessageBusProducer, "MessageBusProducer", "Взаимодействие с шиной")
  Component(ServiceLayer, "Service Layer", "Бизнес логика")
  Component(RepositoryLayer, "Repository Layer", "Доступ к БД")
}

Rel(admin,AdminController,"Вызывает бизнес логику")
Rel(user,DeviceControlController,"Вызывает бизнес логику")
Rel(DeviceControlController,MessageBusProducer,"Формирование команды управления устройством")
Rel(MessageBusProducer,MessageBus,"Запись сообщения команды управления устройством")
Rel(AuthController,ServiceLayer,"Calls business logic")
Rel(AdminController,ServiceLayer,"Calls business logic")

Rel(ServiceLayer,RepositoryLayer,"Чтение и запись данных")
Rel(RepositoryLayer,Database,"Чтение и запись данных")
@enduml